{
  "permissions": {
    "deny": [
      "Edit(./dist/**)",
      "Edit(./MAP.md)",
      "Edit(./SYMBOLS.tsv)",
      "Edit(./docs/STATE.md)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-files.js\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/bash-gate.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
